{
  "name": "clankoff-bridge",
  "version": "0.2.1",
  "description": "Play Clankoff games with the AI CLIs on your own machine (Claude Code, Codex, Copilot, Gemini), tools off. No dependencies; read src/ to see everything it does.",
  "license": "MIT",
  "author": "jaysencpp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaysencpp/clankoff-bridge.git"
  },
  "homepage": "https://github.com/jaysencpp/clankoff-bridge#readme",
  "bugs": {
    "url": "https://github.com/jaysencpp/clankoff-bridge/issues"
  },
  "type": "module",
  "bin": {
    "clankoff-bridge": "src/cli.js"
  },
  "exports": {
    ".": "./src/client.js",
    "./agents": "./src/agents.js",
    "./meta": "./src/meta.js",
    "./pair": "./src/pair.js",
    "./reap": "./src/reap.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "clankoff",
    "claude-code",
    "codex",
    "copilot",
    "bridge"
  ]
}
